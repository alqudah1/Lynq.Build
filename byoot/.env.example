# byoot/ environment variables. No real values — copy to .env.local and fill
# in once the resources in README.md's "What you need to create manually"
# section exist. Never commit .env.local (see .gitignore).

# Neon Postgres — POOLED connection (the "pooler" host Neon gives you),
# used by the app at request time. The byoot_app role — has NO grant on
# listings_vow, and is deliberately NOT the owner of any table (see
# docs/adr/0001-vow-tier-isolation.md's ownership-bypasses-RLS section).
# Must be a DIFFERENT role from whatever authenticates
# DATABASE_URL_UNPOOLED — see README.md's "THREE Postgres roles" section.
DATABASE_URL=

# Neon Postgres — DIRECT/unpooled connection, used ONLY by drizzle-kit for
# migrations (DDL should not run over the pooled connection). Neon's
# default project role is fine here. This role becomes the OWNER of every
# table it creates, including listings_vow — table owners bypass RLS and
# REVOKE entirely, which is exactly why this must NOT be the same role as
# DATABASE_URL. See docs/adr/0001-vow-tier-isolation.md.
DATABASE_URL_UNPOOLED=

# Neon Postgres — POOLED connection again (same endpoint TYPE as
# DATABASE_URL, deliberately — this is read at request time from
# getVowData(), not a migration/admin path, so it has the same
# scalability reasoning as DATABASE_URL, not DATABASE_URL_UNPOOLED's), but
# a DIFFERENT ROLE: the vow_reader role, granted SELECT on listings_vow
# ONLY via the RLS policy in src/db/schema.ts. Must NOT be the same value
# as DATABASE_URL — src/lib/env.ts's requireVowReaderDatabaseUrl() throws
# if they're identical, specifically because that particular mistake would
# otherwise be silent. Used in exactly one place: src/db/client.ts's
# createVowReaderDbClient(), called only from src/lib/listings/vow-gate.ts.
# See README.md for how to create this role, and
# docs/adr/0001-vow-tier-isolation.md for why role separation (not a
# session variable) is the mechanism.
DATABASE_URL_VOW_READER=

# TRREB/PropTx (AMPRE RESO Web API) credentials. Read by src/lib/env.ts but
# not yet used anywhere — src/lib/sync/trebb-sync.ts is a stub with no live
# calls. Do not set these to real values until BYOOT_TRANSFORMATION_PLAN.md
# Section C's synthetic-data-only rule for non-production environments has
# been reviewed — this scaffold's own hard rule is that no real TRREB data
# ever enters this repo, in any environment.
TREBB_API_TOKEN=
TREBB_VOW_TOKEN=

# Defaults to https://query.ampre.ca/odata in code if unset — only set this
# to override (e.g. a sandbox/test endpoint, if PropTx offers one).
TREBB_BASE_URL=
