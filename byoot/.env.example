# byoot/ environment variables. No real values — copy to .env.local and fill
# in once the resources in README.md's "What you need to create manually"
# section exist. Never commit .env.local (see .gitignore).

# Neon Postgres — pooled connection, used by the app at request time.
DATABASE_URL=

# Neon Postgres — direct/unpooled connection, used only by drizzle-kit for
# migrations (DDL should not run over the pooled connection).
DATABASE_URL_UNPOOLED=

# A SEPARATE Neon Postgres role/connection string, granted SELECT on
# listings_vow ONLY (via the vow_reader RLS policy in src/db/schema.ts).
# Must NOT be the same role as DATABASE_URL. Used in exactly one place:
# src/db/client.ts's createVowReaderDbClient(), called only from
# src/lib/listings/vow-gate.ts. See README.md for how to create this role.
DATABASE_URL_VOW_READER=

# TRREB/PropTx (AMPRE RESO Web API) credentials. Read by src/lib/env.ts but
# not yet used anywhere — src/lib/sync/trebb-sync.ts is a stub with no live
# calls. Do not set these to real values until BYOOT_TRANSFORMATION_PLAN.md
# Section C's synthetic-data-only rule for non-production environments has
# been reviewed — this scaffold's own hard rule is that no real TRREB data
# ever enters this repo, in any environment.
TREBB_API_TOKEN=
TREBB_VOW_TOKEN=

# Defaults to https://query.ampre.ca/odata in code if unset — only set this
# to override (e.g. a sandbox/test endpoint, if PropTx offers one).
TREBB_BASE_URL=
