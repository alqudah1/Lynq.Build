# Root LYNQ site / prospecting environment. Never commit real values.
ANTHROPIC_API_KEY="example"
OUTSCRAPER_API_KEY="example"
ZOHO_APP_PASSWORD="example"
OUTREACH_REPLY_TO="mustafa@lynq.build"

# Protects the legacy admin and its prospecting/outreach endpoints.
LYNQ_ADMIN_PASSWORD="replace-with-a-strong-password"
LYNQ_ADMIN_SESSION_SECRET="replace-with-at-least-32-random-bytes"

# Required before an approved commercial email can be sent.
LYNQ_BUSINESS_ADDRESS="full-valid-business-mailing-address"

# Keep the Make webhook URL server-side; never expose it in admin.html.
MAKE_LEAD_WEBHOOK_URL="https://hook.example.invalid/replace-me"
