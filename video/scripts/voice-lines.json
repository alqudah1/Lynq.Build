{
 "lynq-story-1-ar": [
  {
   "at": 0.15,
   "text": "المحل مفتوح. وجوجل بيقول مسكّر."
  },
  {
   "at": 3.25,
   "text": "فالناس بتمرق من قدامه."
  },
  {
   "at": 6.85,
   "text": "الدوام غلط على النت. ولا زبون."
  },
  {
   "at": 10.25,
   "text": "وهاي بس المشكلة الأولى."
  }
 ],
 "lynq-story-2-ar": [
  {
   "at": 0.15,
   "text": "الحل الأول: الدوام الصح."
  },
  {
   "at": 2.85,
   "text": "عشر دقايق. والناس بتفوت."
  },
  {
   "at": 5.85,
   "text": "بعدين بيدوّروا على موقعه."
  },
  {
   "at": 8.75,
   "text": "لسا بيحمّل. راحوا."
  },
  {
   "at": 12.05,
   "text": "ممكن موقع يخسّرك بيعة قبل ما يفتح؟"
  }
 ],
 "lynq-story-3-ar": [
  {
   "at": 0.15,
   "text": "الحل الثاني: موقع بيفتح بثانية."
  },
  {
   "at": 3.35,
   "text": "الدوام. القائمة. زر واحد."
  },
  {
   "at": 6.55,
   "text": "وبيفوتوا."
  },
  {
   "at": 8.75,
   "text": "بعدين بيقرأوا التقييمات."
  },
  {
   "at": 12.15,
   "text": "تقييمه تلاتة وواحد. كنت رحت؟"
  }
 ],
 "lynq-story-4-ar": [
  {
   "at": 0.15,
   "text": "الحل الثالث: رد على كل تقييم."
  },
  {
   "at": 3.75,
   "text": "واطلب من الزباين المبسوطين."
  },
  {
   "at": 8.05,
   "text": "هلق الكل بيتصل. بنفس الوقت."
  },
  {
   "at": 11.65,
   "text": "كل مكالمة فائتة طلب ضايع."
  }
 ],
 "lynq-story-5-ar": [
  {
   "at": 0.15,
   "text": "الحل الرابع: خليهم يطلبوا بدون اتصال."
  },
  {
   "at": 3.05,
   "text": "الطلبات بتوصل. بهدوء."
  },
  {
   "at": 6.75,
   "text": "دوام صح. موقع سريع. ردود على التقييمات. وزر الطلب."
  },
  {
   "at": 9.65,
   "text": "سامي خيالي. بس الحلول حقيقية."
  },
  {
   "at": 11.0,
   "text": "بدك ياها لمحلك؟ راسلنا واكتب فيكس."
  }
 ],
 "pip-ep1-ar": [
  {
   "at": 1.05,
   "text": "بيب عمره ما عمل لعبة."
  },
  {
   "at": 3.05,
   "text": "فكتب بيب جملة وحدة: صاروخ بيهرب من النيازك."
  },
  {
   "at": 6.85,
   "text": "اشتغلت؟!"
  },
  {
   "at": 10.85,
   "text": "أوبس."
  },
  {
   "at": 11.95,
   "text": "الحلقة الجاية، بيب بيصلّحها. تابعنا عشان ما تفوتك."
  }
 ],
 "pip-ep2-ar": [
  {
   "at": 0.15,
   "text": "ضربة وحدة. خلصت اللعبة."
  },
  {
   "at": 3.05,
   "text": "بيب بيجرب كمان مرة."
  },
  {
   "at": 6.35,
   "text": "كل مرة، نفس الشي."
  },
  {
   "at": 9.25,
   "text": "واحد من هالسطور هو السبب. أي سطر؟ اكتب الرقم بالتعليقات."
  }
 ],
 "pip-ep3-ar": [
  {
   "at": 0.15,
   "text": "كان السطر الأول. ولا حياة زيادة، هلق تلاتة."
  },
  {
   "at": 3.75,
   "text": "نجا!"
  },
  {
   "at": 5.55,
   "text": "فبيب ضاف نجوم."
  },
  {
   "at": 8.05,
   "text": "كل النجوم، والنتيجة واحد؟!"
  },
  {
   "at": 11.35,
   "text": "خطأ جديد. وين؟ الجواب بالحلقة الرابعة."
  }
 ],
 "pip-ep4-ar": [
  {
   "at": 0.15,
   "text": "كل النجوم، والنتيجة واحد."
  },
  {
   "at": 2.45,
   "text": "كان السطر التالت. زيد واحد كل مرة."
  },
  {
   "at": 6.05,
   "text": "هلق كل نجمة بتنحسب!"
  },
  {
   "at": 10.35,
   "text": "وبعدين المعلمة بتسأل: إذا السطر التالت صار زائد خمسة، شو بيصير؟"
  }
 ],
 "pip-ep5-ar": [
  {
   "at": 0.15,
   "text": "بيب معه تلات ثواني."
  },
  {
   "at": 2.95,
   "text": "إيه! من أول مرة."
  },
  {
   "at": 5.05,
   "text": "خمس نقاط لكل نجمة."
  },
  {
   "at": 7.85,
   "text": "بيب عملها، وفاهمها."
  },
  {
   "at": 10.15,
   "text": "هلق دور ابنك. يعمل وحدة مجاناً."
  }
 ]
}