# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing a real connection string.
#
# In deployed environments (Vercel), these are set as Vercel Sensitive
# Environment Variables in the platform's own, separate Vercel project —
# never in the repository, never in this file.

# Neon Postgres (provisioned through the Vercel Marketplace), pooled connection.
# Used by the running application at request time.
DATABASE_URL="postgres://user:password@example-pooler.neon.tech/dbname?sslmode=require"

# Neon Postgres, direct (non-pooled) connection.
# Used only by drizzle-kit for generating/applying migrations — DDL is not
# reliable over a pooled connection.
DATABASE_URL_UNPOOLED="postgres://user:password@example.neon.tech/dbname?sslmode=require"

# Durable Office worker. Vercel sends this value as a bearer token to the
# one-minute production cron; use a random value of at least 32 characters.
CRON_SECRET="example-at-least-32-character-random-secret-value"

# The single repository and base branch the Office Engineering employee may
# access. GitHub App installation scope is also verified at runtime.
OFFICE_GITHUB_REPOSITORY="alqudah1/lynq.build"
OFFICE_GITHUB_BASE_BRANCH="main"

# Model routing. When paid AI Gateway credits are enabled, Planning and
# Review can be changed to an Anthropic model while Engineering stays OpenAI.
OFFICE_PLANNING_MODEL="openai/gpt-5.4-mini"
OFFICE_ENGINEERING_MODEL="openai/gpt-5.4-mini"
OFFICE_REVIEW_MODEL="openai/gpt-5.4-mini"

# Optional premium Content Studio motion layer. Runway calls are made only
# after a human explicitly chooses the credit-using premium render. Product
# screens stay on LYNQ's deterministic renderer so the provider cannot invent UI.
RUNWAYML_API_SECRET=""
RUNWAYML_VIDEO_MODEL="gen4.5"

# --- OAuth and Session Foundation (Module 2 Step 3) ---
# See platform/docs/MODULE_2_STEP_3_OAUTH_SESSION_DESIGN.md §10.
# Deliberately separate from, and must never be confused with, Neon Auth's
# own NEON_AUTH_BASE_URL / VITE_NEON_AUTH_URL — see
# platform/docs/MODULE_2_AUTH_AND_TENANCY_DESIGN.md §19 point 6. Those two
# variables must never be read anywhere in this app.

GOOGLE_OAUTH_CLIENT_ID="example-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="example-google-client-secret"

MICROSOFT_OAUTH_CLIENT_ID="example-microsoft-client-id"
MICROSOFT_OAUTH_CLIENT_SECRET="example-microsoft-client-secret"
# Recommended value: "organizations" — restricts sign-in to Entra ID
# work/school accounts across any tenant, never personal Microsoft
# accounts. See the design doc's Microsoft-specific note for why.
MICROSOFT_OAUTH_TENANT_ID="organizations"

# HMAC key signing the pre-auth OAuth state/PKCE cookie. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="example-at-least-32-character-random-secret-value"

# Exact, pre-registered base URL used to construct the OAuth redirect URI —
# must match what's registered with Google/Microsoft exactly, and is never
# derived from request headers.
AUTH_BASE_URL="https://platform.example.com"

# --- Jarvis founder voice notifications (phase one) ---
# A Twilio number imported into Vapi provides the Canadian caller ID. Calls
# remain disabled until the explicit opt-in is true and all four values exist.
# Phase one can call only this +1 founder number for approval/failure alerts;
# it cannot call customers, prospects, restaurants, or emergency services.
JARVIS_VOICE_NOTIFICATIONS_ENABLED="false"
VAPI_API_KEY=""
VAPI_ASSISTANT_ID=""
VAPI_PHONE_NUMBER_ID=""
JARVIS_FOUNDER_PHONE_E164=""
# Bearer token used only by Vapi when sending call status events to
# https://app.lynq.build/api/integrations/vapi/webhook
#
# Any non-empty value authenticates the endpoint, which is what the pre-existing
# outbound founder notifications need. Inbound PHONE CONTROL additionally
# requires at least 32 characters: below that the webhook logs
# "weak_webhook_secret", skips the inbound lane entirely, and the Jarvis screen
# reports "Webhook secret" as still to set up. The floor is deliberately not
# enforced at the door — doing so would 401 the notification lane on any
# deployment whose secret predates the rule.
VAPI_WEBHOOK_SECRET=""

# --- Jarvis secure two-way phone control (inbound founder calls) ---
# Off by default. Inbound phone commands are accepted only when this is
# exactly "true" AND every value below is present and valid. With it off, the
# Vapi webhook behaves exactly as it did before this lane existed: outbound
# founder notification calls are unaffected either way.
JARVIS_PHONE_COMMANDS_ENABLED="false"

# Whether a phone command the risk classifier judges low-risk may open a
# directive with NO human decision. Separate from the flag above and off even
# when phone control is on: the classifier is a lexical gate over speech, and
# ten adversarial reviews put it on the approval screen rather than in the
# decision. Leave this false unless you have read the numbers in
# docs/JARVIS_PHONE_CONTROL.md and accepted the residual risk.
JARVIS_PHONE_AUTO_DISPATCH_ENABLED="false"

# The single organization inbound phone commands act in, and the LYNQ account
# they act as. Both are explicit configuration rather than inferred from the
# caller's number — inferring them would let a spoofed caller ID choose a
# tenant. The founder account must be an owner or admin of this organization,
# which is re-verified against real membership on every call.
JARVIS_PHONE_ORGANIZATION_ID=""
JARVIS_PHONE_FOUNDER_USER_ID=""

# HMAC key for the rotating eight-digit founder verification code. Caller ID is
# spoofable and is never treated as authentication: the founder reads this
# code from the Jarvis Command Center, a page that already requires a signed-in
# owner/admin session. At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JARVIS_PHONE_VERIFICATION_SECRET=""
